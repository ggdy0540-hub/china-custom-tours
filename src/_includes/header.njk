<header class="site-header">
  <div class="container nav-bar">
    <a href="/index.html" class="brand" aria-label="{{ site.brandName }} — Home"><img src="/assets/img/brand-seal.jpg" alt="Logo" class="brand-seal-img" data-cct-key="brand-seal" /><span class="brand-text"><span class="brand-name">{{ site.brandName }}</span><span class="brand-sub">{{ site.brandSub }}</span></span></a>
    <nav class="nav-links" aria-label="Main navigation">
      {% for it in site.nav %}
      {% set base = it.href | replace('.html', '') | replace('/', '') %}
      <a href="{{ it.href }}" {%- if base === active or (base == 'tours' and active.slice(0, 5) == 'tour-') %} class="active"{% endif -%}>{{ it.label }}</a>
      {% endfor %}
      <a href="/contact.html" class="nav-cta"><span class="btn btn-primary btn-sm">Start Planning</span></a>
    </nav>
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
