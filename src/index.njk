<script>
/* Hero 品牌宣传片：静音自动循环铺满首屏 + 原声/全屏观看控件 */
(function () {
  var hero = document.querySelector('.hero');
  if (!hero) return;
  if (window.self !== window.top) return; /* 可视化编辑器预览里不加载 */
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) return; /* 系统偏好减少动态效果时保留原背景图 */

  var mobile = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;
  var LOOP_START = 4.2;   /* 跳过 0-4s 纯黑字幕片头，直接从长城日出起播 */
  var LOOP_END = 69.0;    /* 循环回有画面处，避免结尾淡黑 */
  var watchMode = false;  /* 访客正在完整观看（开原声/全屏）时不打断 */

  var video = document.createElement('video');
  video.className = 'hero-video';
  video.src = 'assets/video/hero-brand-' + (mobile ? '720' : '1080') + '.mp4';
  video.poster = 'assets/video/hero-poster.jpg';
  video.muted = true;
  video.loop = true;
  video.autoplay = true;
  video.playsInline = true;
  video.preload = 'auto';
  video.setAttribute('muted', '');
  video.setAttribute('playsinline', '');
  video.setAttribute('aria-hidden', 'true');
  hero.insertBefore(video, hero.firstChild);
  hero.classList.add('hero-has-video');

  function tryPlay() { var p = video.play(); if (p && p.catch) p.catch(function () {}); }
  tryPlay();
  /* 部分浏览器在数据未就绪时 play() 不生效，数据到了再触发一次 */
  video.addEventListener('loadeddata', tryPlay);
  video.addEventListener('canplay', tryPlay);

  video.addEventListener('loadedmetadata', function () {
    if (!watchMode && video.currentTime < LOOP_START) {
      try { video.currentTime = LOOP_START; } catch (e) {}
    }
  });
  /* 兜底：本地加载极快时 loadedmetadata 可能早于监听器，用 timeupdate 校正 */
  video.addEventListener('timeupdate', function () {
    if (watchMode) return;
    if (video.currentTime < LOOP_START - 0.3 || video.currentTime >= LOOP_END) {
      try { video.currentTime = LOOP_START; } catch (e) {}
    }
  });
  video.addEventListener('error', function () {
    hero.classList.remove('hero-has-video');
    if (video.parentNode) video.parentNode.removeChild(video);
    var c = hero.querySelector('.hero-controls');
    if (c && c.parentNode) c.parentNode.removeChild(c);
  });

  /* ---- 控件 ---- */
  var ICON = {
    mute: '<svg viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.58 15.06 21 13.61 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>',
    sound: '<svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1-3.29-2.5-4.03v8.05c1.5-.74 2.5-2.26 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>',
    pause: '<svg viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>',
    play: '<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>',
    expand: '<svg viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>'
  };

  var bar = document.createElement('div');
  bar.className = 'hero-controls';
  hero.appendChild(bar);

  /* 移动端：控件悬浮在视口右下角，滚出首屏后自动淡出，不遮挡内容 */
  if (mobile && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      bar.classList.toggle('is-hidden', !entries[0].isIntersecting);
    }, { threshold: 0 });
    io.observe(hero);
  }

  function makeBtn(cls, icon, label, title, handler) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'hero-ctrl ' + cls;
    b.title = title;
    b.setAttribute('aria-label', title);
    b.innerHTML = '<span class="hc-ico">' + icon + '</span><span class="hc-txt">' + label + '</span>';
    b.addEventListener('click', handler);
    bar.appendChild(b);
    return b;
  }
  function setBtn(b, icon, label, title) {
    b.innerHTML = '<span class="hc-ico">' + icon + '</span><span class="hc-txt">' + label + '</span>';
    b.title = title; b.setAttribute('aria-label', title);
  }

  function syncSound() {
    if (video.muted) setBtn(soundBtn, ICON.mute, 'Sound on', 'Turn on the original soundtrack');
    else setBtn(soundBtn, ICON.sound, 'Mute', 'Mute the video');
  }
  function syncPlay() {
    if (video.paused) setBtn(pauseBtn, ICON.play, 'Play', 'Play background video');
    else setBtn(pauseBtn, ICON.pause, 'Pause', 'Pause background video');
  }

  var soundBtn = makeBtn('hc-sound', ICON.mute, 'Sound on', 'Turn on the original soundtrack', function () {
    video.muted = !video.muted;
    if (!video.muted) {
      /* 开启原声时从头完整播放，让访客听全旁白与配乐 */
      watchMode = true;
      try { video.currentTime = 0; } catch (e) {}
      tryPlay();
    } else {
      watchMode = false;
      try { video.currentTime = LOOP_START; } catch (e) {}
      tryPlay();
    }
    syncSound(); syncPlay();
  });

  var pauseBtn = makeBtn('hc-pause', ICON.pause, 'Pause', 'Pause background video', function () {
    if (video.paused) tryPlay(); else video.pause();
    syncPlay();
  });
  video.addEventListener('play', syncPlay);
  video.addEventListener('pause', syncPlay);

  makeBtn('hc-film', ICON.expand, 'Watch full film', 'Watch the full brand film with sound', function () {
    watchMode = true;
    video.controls = true;
    video.muted = false;
    try { video.currentTime = 0; } catch (e) {}
    tryPlay();
    syncSound();
    if (video.requestFullscreen) {
      var p = video.requestFullscreen();
      if (p && p.catch) p.catch(function () {});
    } else if (video.webkitEnterFullscreen) {
      video.webkitEnterFullscreen();
    }
  });

  function leaveFilm() {
    if (!watchMode) return;
    watchMode = false;
    video.controls = false;
    video.muted = true;
    try { video.currentTime = LOOP_START; } catch (e) {}
    tryPlay();
    syncSound(); syncPlay();
  }
  document.addEventListener('fullscreenchange', function () {
    if (document.fullscreenElement !== video) leaveFilm();
  });
  video.addEventListener('webkitendfullscreen', leaveFilm);
})();
</script>
