<script>
(function () {
  function initCarousels() {
    document.querySelectorAll('[data-carousel]').forEach(function (root) {
      var track = root.querySelector('.moment-track, .story-track');
      if (!track) return;
      var dots = root.parentElement ? root.parentElement.querySelector('[data-dots]') : null;
      var slides = track.children;
      var step = slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth;
      if (dots && !dots.children.length) {
        for (var i = 0; i < slides.length; i++) {
          (function (idx) {
            var b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('aria-label', 'Go to slide ' + (idx + 1));
            b.addEventListener('click', function () {
              track.scrollTo({ left: idx * step, behavior: 'smooth' });
            });
            dots.appendChild(b);
          })(i);
        }
      }
      root.querySelectorAll('.carousel-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var dir = btn.getAttribute('data-dir') === '1' ? 1 : -1;
          track.scrollBy({ left: dir * step, behavior: 'smooth' });
        });
      });
      function update() {
        if (!dots) return;
        var idx = Math.round(track.scrollLeft / step);
        for (var i = 0; i < dots.children.length; i++) {
          dots.children[i].classList.toggle('active', i === idx);
        }
      }
      track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
      update();
    });
  }
  if (document.readyState !== 'loading') initCarousels();
  else document.addEventListener('DOMContentLoaded', initCarousels);
})();
</script>
<script>
(function () {
  function initReviews() {
    document.querySelectorAll('.quote-grid').forEach(function (grid) {
      var cards = grid.querySelectorAll('.quote-card');
      var BATCH = 6;
      if (cards.length <= BATCH) return; // 不多于一批时无需“查看更多”
      var shown = BATCH;
      for (var i = BATCH; i < cards.length; i++) cards[i].classList.add('batch-hidden');
      var wrap = document.createElement('div');
      wrap.className = 'reviews-more-wrap';
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'reviews-more';
      btn.innerHTML = 'Read more reviews <span class="arr">&#8595;</span>';
      wrap.appendChild(btn);
      grid.parentNode.insertBefore(wrap, grid.nextSibling);
      btn.addEventListener('click', function () {
        if (shown < cards.length) {
          var next = Math.min(shown + BATCH, cards.length);
          for (var j = shown; j < next; j++) cards[j].classList.remove('batch-hidden');
          shown = next;
          if (shown >= cards.length) {
            btn.classList.add('open');
            btn.innerHTML = 'Show less <span class="arr">&#8593;</span>';
          }
        } else {
          for (var k = BATCH; k < cards.length; k++) cards[k].classList.add('batch-hidden');
          shown = BATCH;
          btn.classList.remove('open');
          btn.innerHTML = 'Read more reviews <span class="arr">&#8595;</span>';
          grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }
  if (document.readyState !== 'loading') initReviews();
  else document.addEventListener('DOMContentLoaded', initReviews);
})();
</script>
