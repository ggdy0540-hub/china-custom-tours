  - label: "Customization Form"
    html: |
      <section class="section form-section" id="customize">
            <div class="container form-wrap">
              <div class="section-head reveal">
                <span class="eyebrow centered">Start Customizing</span>
                <h2 class="display-h2">Tell us about your dream trip</h2>
                <p>Share a few details and a travel designer will send you a personalized itinerary draft within 48 hours — free, and with no obligation.</p>
              </div>
              <div class="form-card reveal">
                <form class="js-form" novalidate>
                  <div class="form-grid">
                    <div class="form-field">
                      <label for="t-name">Full Name <span class="req">*</span></label>
                      <input type="text" id="t-name" name="name" data-required placeholder="e.g. Emily Carter" />
                      <span class="error-msg">Please enter your name.</span>
                    </div>
                    <div class="form-field">
                      <label for="t-email">Email Address <span class="req">*</span></label>
                      <input type="email" id="t-email" name="email" data-required placeholder="you@example.com" />
                      <span class="error-msg">Please enter a valid email address.</span>
                    </div>
                    <div class="form-field">
                      <label for="t-dates">Planned Travel Dates</label>
                      <input type="text" id="t-dates" name="dates" placeholder="e.g. April–May 2027, ~12 days" />
                    </div>
                    <div class="form-field">
                      <label for="t-group">Group Size</label>
                      <select id="t-group" name="group">
                        <option value="">Please select…</option>
                        <option>Solo traveler</option>
                        <option>Couple</option>
                        <option>Family with young children</option>
                        <option>Family with teenagers</option>
                        <option>Small group (3–8 friends)</option>
                        <option>Larger group (9+)</option>
                      </select>
                    </div>
                    <div class="form-field full">
                      <label>Your Travel Interests</label>
                      <div class="interest-grid">
                        <label class="interest-option"><input type="checkbox" name="interest" value="culture" checked /><span>Culture &amp; History</span></label>
                        <label class="interest-option"><input type="checkbox" name="interest" value="nature" /><span>Nature &amp; Scenery</span></label>
                        <label class="interest-option"><input type="checkbox" name="interest" value="food" /><span>Food &amp; Markets</span></label>
                        <label class="interest-option"><input type="checkbox" name="interest" value="family" /><span>Family Fun</span></label>
                        <label class="interest-option"><input type="checkbox" name="interest" value="photography" /><span>Photography</span></label>
                        <label class="interest-option"><input type="checkbox" name="interest" value="city" /><span>City Life</span></label>
                        <label class="interest-option"><input type="checkbox" name="interest" value="hiking" /><span>Hiking &amp; Trekking</span></label>
                        <label class="interest-option"><input type="checkbox" name="interest" value="festivals" /><span>Festivals &amp; Traditions</span></label>
                      </div>
                    </div>
                    <div class="form-field full">
                      <label for="t-budget">Approximate Budget (per person)</label>
                      <select id="t-budget" name="budget">
                        <option value="">Please select…</option>
                        <option>Under $1,500</option>
                        <option>$1,500 – $2,500</option>
                        <option>$2,500 – $4,000</option>
                        <option>$4,000+ / premium &amp; luxury</option>
                        <option>Not sure yet — advise me</option>
                      </select>
                    </div>
                    <div class="form-field full">
                      <label for="t-message">Anything Else We Should Know?</label>
                      <textarea id="t-message" name="message" placeholder="Must-sees, mobility needs, dietary requirements, celebration occasions, hotels you love…"></textarea>
                    </div>
                    <div class="form-field full" style="text-align: center; margin-top: 10px;">
                      <button type="submit" class="btn btn-primary">Request My Free Itinerary <span class="arr">&rarr;</span></button>
                    </div>
                  </div>
                  <p class="form-note">We reply within 24 hours with first ideas and an honest, no-obligation quote. Your details are never shared.</p>
                </form>
                <div class="form-success" role="status">
                  <div class="success-icon"><svg fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
                  <h3>Thank you — your request is on its way!</h3>
                  <p>A travel designer is already thinking about your journey. Expect a personal email with initial itinerary ideas within 24 hours.</p>
                </div>
              </div>
            </div>
          </section>
  - label: "CTA"
    html: |
      <section class="cta-band">
            <div class="container cta-inner">
